        .hgrid2 { display:grid; gap:12px; grid-template-columns:repeat(2,1fr); }
        .hgrid3 { display:grid; gap:12px; grid-template-columns:repeat(2,1fr); }
        .hgrid4 { display:grid; gap:12px; grid-template-columns:repeat(2,1fr); }
        @media(min-width:640px){ .hgrid3{grid-template-columns:repeat(3,1fr);} .hgrid4{grid-template-columns:repeat(4,1fr);} }
        @media(min-width:1024px){ .hgrid4{grid-template-columns:repeat(4,1fr); gap:16px;} }
        .cat-scroll{ display:flex; gap:10px; overflow-x:auto; padding-bottom:8px; scrollbar-width:none; }
        .cat-scroll::-webkit-scrollbar{display:none;}
        .prod-scroll{ display:flex; gap:12px; overflow-x:auto; padding-bottom:8px; scrollbar-width:none; scroll-behavior:smooth; }
        .prod-scroll::-webkit-scrollbar{display:none;}
        .prod-scroll-item{ flex-shrink:0; width:160px; }
        @media(min-width:640px){ .prod-scroll-item{ width:200px; } }
        .testimonial-card{ flex-shrink:0; width:240px; background:var(--bg2); border:1px solid var(--border); border-radius:14px; padding:18px; }
        @media(min-width:640px){ .testimonial-card{ width:280px; } }
        .brand-scroll{ display:flex; gap:8px; overflow-x:auto; padding-bottom:6px; scrollbar-width:none; scroll-behavior:smooth; }
        .brand-scroll::-webkit-scrollbar{display:none;}
        .brand-scroll-item{ flex-shrink:0; width:calc((100vw - 56px) / 3); max-width:120px; }
        @media(min-width:640px){ .brand-scroll-item{ width:110px; } }
        .scroll-btn{ width:34px; height:34px; border-radius:50%; border:none; cursor:pointer; display:flex; align-items:center; justify-content:center; font-size:16px; font-weight:700; transition:all 0.2s; flex-shrink:0; }
        .scroll-btn:hover{ transform:scale(1.1); }
        .cat-pill{ flex-shrink:0; display:flex; flex-direction:column; align-items:center; gap:6px; text-decoration:none; }
        .cat-circle{ width:70px; height:70px; border-radius:50%; background:#161616; border:2px solid #222; display:flex; align-items:center; justify-content:center; font-size:26px; transition:all .25s; }
        .cat-pill:hover .cat-circle{ border-color:${B}; background:#1a0a0e; transform:scale(1.08); }
        .trust-grid{ display:grid; gap:0; grid-template-columns:repeat(2,1fr); }
        @media(min-width:768px){ .trust-grid{ grid-template-columns:repeat(4,1fr); } }
        .stat-grid{ display:grid; gap:1px; grid-template-columns:repeat(2,1fr); background:#111; }
        @media(min-width:640px){ .stat-grid{grid-template-columns:repeat(4,1fr);} }
        .sec{ max-width:1200px; margin:0 auto; padding:0 16px; }
        .sec-title{ font-size:clamp(18px,4vw,26px); font-weight:900; letter-spacing:2px; text-transform:uppercase; margin:0 0 4px; }
        .banner-inner{ display:flex; flex-direction:column; gap:20px; }
        @media(min-width:768px){ .banner-inner{flex-direction:row; align-items:center; justify-content:space-between;} }
        .footer-grid{ display:grid; gap:32px; grid-template-columns:1fr; }
        @media(min-width:768px){ .footer-grid{grid-template-columns:repeat(2,1fr);} }
        @media(min-width:1024px){ .footer-grid{grid-template-columns:2fr 1fr 1fr 1.5fr;} }
        .faq-grid{ display:grid; gap:10px; grid-template-columns:1fr; }
        @media(min-width:768px){ .faq-grid{grid-template-columns:repeat(2,1fr);} }
        .brand-grid{ display:grid; gap:8px; grid-template-columns:repeat(3,1fr); }
        @media(min-width:640px){ .brand-grid{grid-template-columns:repeat(5,1fr);} }
        .fl{ color:#737373; text-decoration:none; font-size:13px; line-height:2; display:block; transition:color .2s; }
        .fl:hover{ color:${B}; }
        @keyframes ticker{ 0%{transform:translateX(0)} 100%{transform:translateX(-50%)} }
        .ticker-inner{ display:flex; gap:0; animation:ticker 20s linear infinite; width:max-content; }
        .ticker-inner:hover{ animation-play-state:paused; }
        @keyframes stat-pop { 0% { opacity:0; transform:scale(0.85) translateY(10px); } 100% { opacity:1; transform:scale(1) translateY(0); } }
        @keyframes gear-fade { 0% { opacity:0; transform:translateY(8px); } 100% { opacity:1; transform:translateY(0); } }
