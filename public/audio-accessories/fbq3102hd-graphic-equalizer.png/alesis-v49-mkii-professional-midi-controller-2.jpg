        .hero-slide { position: absolute; inset: 0; transition: opacity 0.9s ease; }
        .hero-kb { animation: heroKenBurns 7s ease-out both; }
        @keyframes heroKenBurns { from { transform: scale(1.03); } to { transform: scale(1.12); } }
        .hero-anim { animation: heroFadeUp 0.7s cubic-bezier(0.22, 1, 0.36, 1) both; }
        @keyframes heroFadeUp { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: none; } }
        @keyframes heroFill { from { width: 0%; } to { width: 100%; } }
        .hero-arrow {
          position: absolute; top: 50%; transform: translateY(-50%);
          z-index: 6; width: 42px; height: 42px; border-radius: 50%;
          background: rgba(0,0,0,0.35); border: 1px solid rgba(255,255,255,0.25);
          color: #fff; cursor: pointer; display: flex; align-items: center; justify-content: center;
          backdrop-filter: blur(6px); transition: background 0.2s ease, transform 0.2s ease;
        }
        .hero-arrow:hover { background: rgba(0,0,0,0.6); transform: translateY(-50%) scale(1.08); }
        .hero-arrow-left { left: 14px; }
        .hero-arrow-right { right: 14px; }
        @media (max-width: 767px) { .hero-arrow { display: none; } }
        @media (prefers-reduced-motion: reduce) {
